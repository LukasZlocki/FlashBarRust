export struct ResultRow {
    name: string,
}

export component AppWindow inherits Window {
    in-out property <[ResultRow]> results;
    callback query-changed(string);

    title: "FlashBar";
    width: 600px;
    height: 220px;
    no-frame: true;
    background: transparent;
    forward-focus: search;

    Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        background: black;
        border-radius: 24px;

        FocusScope {
            key-pressed(event) => {
                if (event.text == Key.Escape) {
                    root.hide();
                    return accept;
                }
                return reject;
            }

            VerticalLayout {
                padding: 16px;
                spacing: 10px;

                Rectangle {
                    height: 40px;
                    border-radius: 12px;
                    background: #1e1e1e;

                    Text {
                        x: 14px;
                        width: 100%;
                        height: 100%;
                        text: "search";
                        color: #777777;
                        font-size: 16px;
                        vertical-alignment: center;
                        visible: search.text == "";
                    }

                    search := TextInput {
                        x: 14px;
                        width: parent.width - 28px;
                        height: 100%;
                        color: white;
                        font-size: 16px;
                        single-line: true;
                        vertical-alignment: center;
                        edited => {
                            root.query-changed(self.text);
                        }
                    }
                }

                VerticalLayout {
                    spacing: 2px;

                    for row in root.results : Rectangle {
                        height: 26px;
                        border-radius: 6px;

                        HorizontalLayout {
                            padding-left: 8px;
                            spacing: 10px;

                            Rectangle {
                                width: 18px;
                                height: 18px;
                                border-radius: 4px;
                                background: #3a3a3a;
                            }

                            Text {
                                text: row.name;
                                color: white;
                                font-size: 14px;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                    }
                }
            }
        }
    }
}
